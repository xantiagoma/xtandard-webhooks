{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "types": ["bun"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "scripts/vendor.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "test/**/*.bun.test.ts",
    // Built/checked against Elysia 2 via tsconfig.elysia2.json.
    "src/adapters/elysia2.ts",
    "src/entry-elysia2.ts",
    "test/elysia2.test.ts"
  ]
}
