{
  // The family compiler setup (and Vite asset module types) from the kit.
  "extends": "@xtandard/kit/tsconfig/base.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx"],
  "exclude": [
    "dist",
    "node_modules",
    "test/**/*.bun.test.ts",
    // Built/checked against Elysia 2 via tsconfig.elysia2.json.
    "src/adapters/elysia2.ts",
    "src/entry-elysia2.ts",
    "test/elysia2.test.ts"
  ]
}
