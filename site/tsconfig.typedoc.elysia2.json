{
  // The program TypeDoc reads for the `/elysia2` entry point alone. The adapter imports plain
  // `elysia` (what consumers install), which the main program (tsconfig.typedoc.json) resolves to
  // Elysia 1; here it resolves to the `elysia-v2` devDep alias, as in ../tsconfig.elysia2.json.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "elysia": ["../node_modules/elysia-v2"]
    }
  },
  "include": ["../src/entry-elysia2.ts", "../scripts/vendor.d.ts"],
  "exclude": ["../dist", "../node_modules"]
}
